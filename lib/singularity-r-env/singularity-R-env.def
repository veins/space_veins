Bootstrap: docker

From: docker-r-env:0.0.2

Registry: docker-registry.iai.inf.tu-dresden.de

%labels
    Author sommer@cms-labs.org research@m-franke.net
    Version v0.0.2

%help
    Singularity container providing a R environment for plotting simulation results
    Tested with Singularity 3.5.2.

    Run this container with its `--help` option for details:
    ```
    singularity run singularity-r-env.sif --help
    ```

%environment
    export LC_ALL=C
    #PATH
    export PATH="$PATH:/opt/mambaforge/bin"

%setup
    # create stub hosts file contents (necessary for resolving "localhost" if network isolation is turned on)
    test -s "${SINGULARITY_ROOTFS}/etc/hosts" || echo '127.0.0.1\tlocalhost' >> "${SINGULARITY_ROOTFS}/etc/hosts"

